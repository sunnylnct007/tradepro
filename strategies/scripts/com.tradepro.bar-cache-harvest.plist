<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  tradepro bar-cache daily harvest
  Runs Mon–Fri at 21:15 UTC (5:15 PM ET) — 75 min after 4 PM market close.
  Fetches today's 1m bars for the full intraday_flat universe via IBKR TWS.

  Install:
    cp scripts/com.tradepro.bar-cache-harvest.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.tradepro.bar-cache-harvest.plist

  Unload:
    launchctl unload ~/Library/LaunchAgents/com.tradepro.bar-cache-harvest.plist

  Run immediately (test):
    launchctl kickstart -k gui/$(id -u)/com.tradepro.bar-cache-harvest

  Logs:
    ~/.tradepro/logs/bar-cache-harvest.log
    ~/.tradepro/logs/bar-cache-harvest.err
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tradepro.bar-cache-harvest</string>

    <!--
      Daily cron — yfinance fallback is ACCEPTABLE here because this only
      harvests TODAY's session and TWS may briefly lag behind the cron.
      For historical backfill use --ibkr-only explicitly.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/skumar/sourcecode/tradepro/tradepro-laneB/strategies/scripts/bar-cache-harvest.sh</string>
        <string>--resolution</string>
        <string>1m</string>
        <string>--asset</string>
        <string>us_etf</string>
        <string>--allow-partial</string>
        <string>--verbose</string>
        <!-- No --ibkr-only here: yfinance is a same-day fallback if TWS lags -->
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>TRADEPRO_IBKR_PORT</key>
        <string>7500</string>
        <key>HOME</key>
        <string>/Users/skumar</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>TRADEPRO_PROJECT_DIR</key>
        <string>/Users/skumar/sourcecode/tradepro/tradepro-laneB/strategies</string>
        <key>TRADEPRO_API_URL</key>
        <string>http://16.60.201.137</string>
    </dict>

    <!--
      Run at 21:15 UTC Monday–Friday.
      Weekday: 1=Mon 2=Tue 3=Wed 4=Thu 5=Fri
    -->
    <!-- WEEKLY, not nightly (22 Aug 2026): consumer mapping proved NO live
         lane reads 1m parquet — every running strategy/screen uses 5m/1d.
         One Saturday sweep keeps the 1m archive growing inside IBKR's
         ~1-year 1m history ceiling (a week's gap is recoverable; the
         nightly cost was the single heaviest load on the shared OAuth
         session). Existing 1m partitions are kept: tradepro-slippage-sweep
         and operator backtests read them on demand. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>6</integer>
        <key>Hour</key><integer>11</integer>
        <key>Minute</key><integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/skumar/.tradepro/logs/bar-cache-harvest.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/skumar/.tradepro/logs/bar-cache-harvest.err</string>

    <!-- Don't harvest on load — wait for the scheduled time -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
