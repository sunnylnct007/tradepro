<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tradepro.signal-watch</string>
  <!-- Every 15 minutes, not once a day. The old wiring ran signal-watch only
       inside screener-daily at 15:12 BST — BEFORE the US open — so a stop
       breached during the session went unseen until the next afternoon. A
       watcher that looks once a day is a diary, not a watcher.
       signal_watch dedupes via _fired_today(), so a quiet tick costs one
       API read and repeat ticks cannot re-send the same alert. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>cd /Users/skumar/sourcecode/tradepro/tradepro/strategies &amp;&amp; uv run tradepro-signal-watch >> "$HOME/.tradepro/logs/signal-watch-$(date -u +%Y-%m-%d).log" 2>&amp;1</string>
  </array>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/tmp/tradepro-signal-watch.log</string>
  <key>StandardErrorPath</key><string>/tmp/tradepro-signal-watch.log</string>
</dict>
</plist>
