# Container-image Lambda for TradePro's light scheduled jobs.
#
# A container rather than a zip + layer: pandas, numpy, pyarrow and yfinance
# comfortably exceed Lambda's 250MB unzipped layer limit, and the repo already
# builds and pushes images to ECR for the API — so this reuses a pipeline that
# exists rather than introducing a second packaging story.
FROM public.ecr.aws/lambda/python:3.12

# Dependencies first so a code change does not re-resolve the whole tree.
#
# THE DEPENDENCY LIST IS pyproject.toml, NOT THIS FILE. Until 25 Nov 2026 this
# step hand-listed eleven packages. The paper session's order push imports
# httpx; the image had none; `_push_pending` logged one WARNING and dropped
# the order while the router still printed its "AUTO-OMS" line. AMD closed
# below its trailing stop on 24 Nov and the rotation sleeve's first stop exit
# never reached the OMS — every tick of 25 Nov decided "exit-trailing-stop"
# and sent nothing. Two lists for one truth is the hand-maintained-allow-list
# shape again (see tests/test_image_ships_the_placement_path.py). Core deps
# plus the `ibkr` extra the Mac lanes run with (`uv run --extra ibkr`).
COPY pyproject.toml ${LAMBDA_TASK_ROOT}/
RUN python -m pip install --no-cache-dir --upgrade pip && \
    python -c "import tomllib; d = tomllib.load(open('pyproject.toml', 'rb'))['project']; \
print('\n'.join(d['dependencies'] + d['optional-dependencies']['ibkr']))" > /tmp/requirements.txt && \
    python -m pip install --no-cache-dir -r /tmp/requirements.txt

COPY tradepro_strategies ${LAMBDA_TASK_ROOT}/tradepro_strategies
COPY lambda_handler.py   ${LAMBDA_TASK_ROOT}/

# THE UNIVERSE, which is NOT inside the package. `universe.py` resolves it as
# `parents[1] / "universe" / "tradeable.json"` — a sibling of tradepro_strategies,
# so copying the package alone left the image with no universe at all.
#
# The screen then evaluated ZERO names and pushed an EMPTY board over a good one
# while reporting ok/rc=0 (31 Aug 2026: "scanned 0 recent reporters", 9 seconds,
# against 8 reporters and one candidate locally). The file is the definition of
# what we trade; it has to travel with the code that screens it.
COPY universe ${LAMBDA_TASK_ROOT}/universe

# WHICH COMMIT IS ACTUALLY RUNNING. Baked at build time, exactly as the API
# bakes BACKEND_COMMIT so /health/details can answer "is this the SHA I just
# pushed?". Without it a scheduled job cannot say what code it is, and on
# 31 Aug 2026 this function ran a hand-uploaded 30 Aug image for a full day —
# refusing to price every night while main looked correct — and NOTHING
# reported it. An unstamped image is now itself an alarm: see lambda_handler.
ARG JOBS_COMMIT=unknown
ARG JOBS_BUILD_TIME=unknown
ENV JOBS_COMMIT=${JOBS_COMMIT} \
    JOBS_BUILD_TIME=${JOBS_BUILD_TIME}

# Lambda's filesystem is read-only except /tmp, and the package writes caches
# and a ledger under ~/.tradepro. Repointing HOME here means the code needs no
# Lambda-specific branches.
ENV HOME=/tmp \
    TRADEPRO_MACHINE=lambda:tradepro-jobs \
    PYTHONUNBUFFERED=1 \
    MPLCONFIGDIR=/tmp/.mpl

CMD ["lambda_handler.handler"]
