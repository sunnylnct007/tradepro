# Caddy reverse proxy in front of the frontend nginx container.
#
# Two virtual hosts:
#   1. tradepro.showsoldprice.com — Caddy auto-fetches a Let's Encrypt
#      certificate via the HTTP-01 challenge on port 80 and serves
#      HTTPS on 443. Auto-renews every ~60 days.
#   2. The bare IP (port 80) — keeps the legacy http://16.60.201.137/
#      access working for anything still bookmarked there. Let's
#      Encrypt can't issue certs for raw IPs, so this stays HTTP-only.
#
# Both proxy to `frontend:80` on the internal Docker network where
# nginx serves the SPA + reverse-proxies /api/* to the api container.

tradepro.showsoldprice.com {
	# Standard hardening headers — minimal because the frontend nginx
	# already sets the SPA-specific ones (CSP, X-Content-Type-Options).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy "no-referrer-when-downgrade"
	}

	# ── MCP endpoint for remote agents (claude.ai in the browser, any
	# other Claude Code session). Routed straight to the `mcp` container
	# — deliberately NOT through the frontend nginx, whose Basic Auth
	# gate would 401 the handshake before tools/list could run. That was
	# the whole reason the registered connectors showed "connected, no
	# tools": the URL resolved to the Basic-Auth'd SPA.
	#
	# The surface behind this is read-only (build_server(read_only=True)
	# strips everything that can trade). Access control is the secret
	# path segment the mcp container requires — TRADEPRO_MCP_PATH_TOKEN,
	# supplied from /opt/tradepro/.env, never from this file. This
	# matcher is a prefix so the token stays out of the repo.
	#
	# No `encode` here and flush_interval -1: streamable HTTP replies are
	# SSE, and compressing or buffering them stalls the stream.
	handle /mcp* {
		reverse_proxy mcp:5085 {
			flush_interval -1
		}
	}

	# ── OAuth DISCOVERY must 404, not 401 ─────────────────────────────
	# The MCP endpoint above needs no OAuth: access is the secret path
	# segment. But a client cannot know that unless we answer the
	# discovery probes, and these paths were never routed — so they fell
	# through to `handle {}` below, hit the frontend nginx, and returned
	# the SPA's Basic Auth 401 in HTML.
	#
	# A 401 on these paths is precisely the signal for "this resource is
	# OAuth-protected". So Claude concluded it had to register a client,
	# POSTed /register, got another Basic Auth 401, and reported
	# "Couldn't register with Tradepro's sign-in service" — while the MCP
	# server itself was answering 200 and serving all 101 tools. The
	# server never asked for OAuth; the SPA's auth gate answered on its
	# behalf.
	#
	# This is the SAME bug as the one recorded above, one layer along:
	# /mcp was pointed away from the Basic-Auth'd SPA, its discovery
	# paths were not. 404 means "no OAuth here", which is the truth, and
	# the client then proceeds with the path token as-is.
	#
	# Scoped to oauth-* deliberately: /.well-known/acme-challenge must
	# keep working or the TLS certificate stops renewing.
	handle /.well-known/oauth-authorization-server* {
		respond 404
	}

	handle /.well-known/oauth-protected-resource* {
		respond 404
	}

	handle /.well-known/openid-configuration* {
		respond 404
	}

	handle /register {
		respond 404
	}

	handle {
		encode gzip
		reverse_proxy frontend:80
	}
}

# Catch-all for any other Host header (e.g. raw IP). HTTP-only because
# Caddy can't auto-cert for an IP. ACME challenge paths under
# /.well-known/acme-challenge/* are handled by Caddy before this block.
:80 {
	reverse_proxy frontend:80
}
